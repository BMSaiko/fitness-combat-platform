{
  "name": "fitness-combat-platform",
  "version": "0.1.0",
  "description": "All-in-one platform for gyms, martial arts academies, and fitness professionals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "dev:mobile": "turbo run dev --filter=./apps/mobile",
    "dev:web": "turbo run dev --filter=./apps/web-admin",
    "dev:api": "turbo run dev --filter=./packages/api-gateway"
  },
  "devDependencies": {
    "turbo": "^1.10.12",
    "typescript": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "husky": "^8.0.3",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.6.7"
}