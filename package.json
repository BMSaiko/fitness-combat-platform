{
  "name": "fitness-combat-platform",
  "version": "0.1.0",
  "description": "All-in-one platform for gyms, martial arts academies, and fitness professionals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "echo \"Tests not configured yet\" && exit 0",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "type-check:strict": "turbo run type-check -- --strict",
    "type-check:watch": "turbo run type-check -- --watch",
    "build:types": "turbo run build --filter=./packages/*",
    "clean": "turbo run clean",
    "dev:mobile": "turbo run dev --filter=./apps/mobile",
    "dev:web": "turbo run dev --filter=./apps/web-admin",
    "dev:api": "turbo run dev --filter=./packages/api-gateway",
    "deploy:staging": "echo \"Staging deployment not configured yet\" && exit 0",
    "deploy:production": "echo \"Production deployment not configured yet\" && exit 0",
    "deploy:all": "npm run build && npm run deploy:staging"
  },
  "devDependencies": {
    "turbo": "^1.10.12",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "husky": "^8.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.2.4"
}
